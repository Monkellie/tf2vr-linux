#!/usr/bin/env bash
# Start Titanfall 2 VR (CircuitLord's TF2VR mod) through Proton-TF2VR.
# Usage: tf2vr [--proton-log] [extra game args...]     e.g. tf2vr +map sp_crashsite
#   --proton-log   also save Proton's log (PROTON_LOG=1) to ~/.local/state/tf2vr/steam-1237970.log
#
# Mirrors what CircuitLordVRModInstaller.exe does when you press Play on Windows:
# crash_monitor.exe starts Titanfall2VRLauncher.exe (Northstar) with the TF2VR profile,
# the arguments from TF2VR/tools/launch.json and TF2VR_OPENXR=1.
# Paths come from ~/.config/tf2vr/paths.env, written by install.sh.
set -uo pipefail

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/tf2vr/paths.env"
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/tf2vr"
mkdir -p "$LOG_DIR"
LOG="$LOG_DIR/launch.log"
exec > >(tee "$LOG") 2>&1

PROTON_LOG_FILE=""
if [ "${1:-}" = "--proton-log" ]; then
  shift
  export PROTON_LOG=1 PROTON_LOG_DIR="$LOG_DIR"
  PROTON_LOG_FILE="$LOG_DIR/steam-1237970.log"
  rm -f "$PROTON_LOG_FILE"
  echo "Proton log: $PROTON_LOG_FILE"
fi

die() {
  echo "ERROR: $1"
  command -v notify-send >/dev/null 2>&1 && notify-send -a "Titanfall 2 VR" -i dialog-error "Titanfall 2 VR" "$1"
  exit 1
}

# Windows path of a Linux path, as Wine sees it through drive Z:
win() { local p; p=$(readlink -f "$1"); printf 'Z:%s' "${p//\//\\}"; }

[ -f "$CONF" ] || die "Not installed - run install.sh from tf2vr-linux first."
# shellcheck source=/dev/null
. "$CONF"
G="$GAME_DIR"
for f in Titanfall2VRLauncher.exe TF2VR/Northstar.dll TF2VR/plugins/Titanfall2VR.dll \
         TF2VR/tools/crash_monitor.exe TF2VR/tools/launch.json; do
  [ -f "$G/$f" ] || die "$G/$f is missing - run install.sh again."
done
[ -x "$PROTON_BIN" ] || die "$PROTON_BIN is missing - run install.sh again."

# Mods that drop their own DirectX next to the game take Present away from VR rendering
for f in "$G"/{,bin/x64_retail/}{dxgi,d3d11}.dll; do
  [ -f "$f" ] && die "Another mod replaced DirectX files, which breaks VR rendering. Remove $f and launch again."
done

python3 - "$(dirname "$PROTON_BIN")/files/lib/wine/x86_64-windows/mmdevapi.dll" <<'PY' \
  || echo "WARNING: the mmdevapi.dll audio fix isn't applied - expect a 0xC0000409 crash. Run install.sh --refresh-proton."
import sys
data = open(sys.argv[1], "rb").read()
sys.exit(0 if data[0x369E:0x369E + 6] == bytes.fromhex("0f843efdffff") else 1)
PY

pgrep -x steam >/dev/null || die "Steam isn't running - start Steam first."

# Only SteamVR needs starting here; other OpenXR runtimes (WiVRn, Monado) are started by you
RUNTIME_JSON="${XDG_CONFIG_HOME:-$HOME/.config}/openxr/1/active_runtime.json"
[ -f "$RUNTIME_JSON" ] || RUNTIME_JSON=/etc/xdg/openxr/1/active_runtime.json
[ -f "$RUNTIME_JSON" ] || die "No OpenXR runtime is active. In SteamVR: Settings -> OpenXR -> Set SteamVR as OpenXR runtime."
if grep -qiE 'steamvr|steamxr' "$(readlink -f "$RUNTIME_JSON")"; then
  if ! pgrep -x vrserver >/dev/null; then
    echo "Starting SteamVR..."
    steam steam://rungameid/250820 >/dev/null 2>&1 &
    for _ in $(seq 1 60); do pgrep -x vrserver >/dev/null && break; sleep 1; done
    pgrep -x vrserver >/dev/null || die "SteamVR didn't start - start it yourself, check the headset shows up, then launch again."
    sleep 5
  fi
else
  echo "OpenXR runtime: $(readlink -f "$RUNTIME_JSON") - make sure it's running and the headset is connected."
fi

# Same environment the Windows installer gives the game
while IFS= read -r v; do
  case "$v" in TF2VR_*) unset "$v" ;; esac
done < <(compgen -e)
unset XR_RUNTIME_JSON VR_PATHREG_OVERRIDE VR_CONFIG_PATH VR_LOG_PATH
export TF2VR_OPENXR=1

# Settings often set globally for other games that this setup can't use or isn't tested with.
# VR needs DXVK: wineopenxr hands the game's D3D11 frames to the headset as DXVK textures,
# so wined3d leaves the headset with nothing to show.
for v in PROTON_USE_WINED3D PROTON_USE_WINED3D11 PROTON_ENABLE_WAYLAND MANGOHUD; do
  [ -n "${!v+x}" ] || continue
  case "$v" in
    PROTON_USE_WINED3D*)   why="VR needs DXVK, wined3d can't send frames to the headset" ;;
    PROTON_ENABLE_WAYLAND) why="the EA app and VR are only tested with Wine's X11 driver" ;;
    MANGOHUD)              why="overlays aren't tested with the EA app and VR" ;;
  esac
  [ "${!v}" != 0 ] && echo "WARNING: ignoring $v=${!v} - $why."
  unset "$v"
done
export STEAM_COMPAT_CLIENT_INSTALL_PATH="$STEAM_ROOT"
export STEAM_COMPAT_DATA_PATH="$PREFIX_DIR"
# Proton's steam.exe only sets up the VR bridge (vrclient_init_registry, which wineopenxr needs)
# for processes it thinks Steam launched; without these xrCreateInstance crashes the mod.
export SteamGameId=1237970 SteamAppId=1237970

# Wine processes of this prefix: their binaries live in Proton's files/ (unlike this script, tee
# and the python proton script), and Proton gives them WINEPREFIX
PROTON_FILES="$(readlink -f "$(dirname "$PROTON_BIN")")/files/"
PFX_CANON=$(readlink -f "$PREFIX_DIR/pfx")
prefix_pids() {
  local p t exe
  for p in /proc/[0-9]*; do
    t=$p
    # When the main thread has exited (xalia.exe does) only the other threads can be read
    if ! exe=$(readlink "$p/exe" 2>/dev/null); then
      for t in "$p"/task/*; do exe=$(readlink "$t/exe" 2>/dev/null) && break; done
    fi
    case "$exe" in "$PROTON_FILES"*) ;; *) continue ;; esac
    grep -qzxF -e "WINEPREFIX=$PREFIX_DIR/pfx" -e "WINEPREFIX=$PREFIX_DIR/pfx/" \
      -e "WINEPREFIX=$PFX_CANON" -e "WINEPREFIX=$PFX_CANON/" "$t/environ" 2>/dev/null && echo "${p#/proc/}"
  done
}
# Processes blocked in an ntsync wait outlive their wineserver and then wait forever (explorer.exe
# among them, which keeps showing the EA tray icon). Without a wineserver nothing in the session
# can recover, so end them. Returns 0 if it killed something.
kill_orphans() {
  local pids p
  pids=$(prefix_pids)
  [ -n "$pids" ] || return 1
  for p in $pids; do
    [ "$(basename "$(readlink "/proc/$p/exe" 2>/dev/null)")" = wineserver ] && return 1
  done
  # shellcheck disable=SC2086
  kill -KILL $pids 2>/dev/null
  return 0
}
kill_orphans && echo "Closed Wine processes left over from an earlier session."

# Northstar needs a signed-in EA app; start it first so the launcher doesn't hang at "LSX: connect()".
# EA's process name is CrBrowserMain, so match argv[0] instead (from polar421's launcher).
# "EA Desktop\EA Desktop" is the EA app's link to its current version folder; Wine resolves it.
EA_EXE='C:\Program Files\Electronic Arts\EA Desktop\EA Desktop\EADesktop.exe'
ea_running() {
  local p
  for p in /proc/[0-9]*; do
    case "$(tr '\0' '\n' 2>/dev/null < "$p/cmdline" | head -n 1)" in
      *'\EADesktop.exe') return 0 ;;
    esac
  done
  return 1
}
EA_DATA="$PREFIX_DIR/pfx/drive_c/ProgramData/EA Desktop"
ea_signed_in() {
  local size
  size=$(stat -c %s "$EA_DATA/Logs/EADesktop.log" 2>/dev/null) || return 1
  [ "$size" -ge "$ea_log_start" ] || ea_log_start=0
  grep -q onAuthSuccessUpdated < <(tail -c +$((ea_log_start + 1)) "$EA_DATA/Logs/EADesktop.log")
}
if ! ea_running; then
  # The EA app finds its background service through this file. A killed session leaves it behind,
  # and when the new service gets the old one's Wine PID, the EA app dials the dead port for 20 s,
  # signs in late, and the game, which checks the login once at startup, says you're logged out.
  rm -f "$EA_DATA/backgroundservice.ini"
  ea_log_start=$(stat -c %s "$EA_DATA/Logs/EADesktop.log" 2>/dev/null || echo 0)
  echo "Starting the EA app..."
  "$PROTON_BIN" run "$EA_EXE" >/dev/null 2>&1 &
  for _ in $(seq 1 45); do ea_running && break; sleep 1; done
  ea_running || die "The EA app didn't start. Launch Titanfall 2 normally from Steam once to check you're signed in."
  signed_in=0
  for i in $(seq 1 180); do
    ea_signed_in && { signed_in=1; break; }
    [ "$i" = 15 ] && echo "Waiting for the EA app to sign in - if its window asks, sign in there."
    sleep 1
  done
  if [ "$signed_in" = 1 ]; then
    echo "EA app signed in."
    sleep 2
  else
    echo "WARNING: couldn't confirm the EA app signed in. If the game says you're logged out, sign in to the EA app and launch again."
  fi
fi

# Arguments from the mod's launch.json, filled in the way the Windows installer does
mapfile -t ARGS < <(python3 - "$G/TF2VR/tools/launch.json" <<'PY'
import json, sys
s = json.load(open(sys.argv[1]))
for arg in s["arguments"] + s["vrArguments"]:
    print(arg.replace("{profile}", "TF2VR").replace("{width}", "1280")
             .replace("{height}", "720").replace("{sound}", "1"))
PY
)
[ "${#ARGS[@]}" -gt 0 ] || die "Couldn't read $G/TF2VR/tools/launch.json"

PRESENCE="${XDG_DATA_HOME:-$HOME/.local/share}/tf2vr/discord-presence.py"
presence_pid=""
if [ -f "$PRESENCE" ]; then
  python3 "$PRESENCE" "$G/TF2VR/logs" $$ &
  presence_pid=$!
fi

echo "Launching Titanfall 2 VR (log: $LOG)"
cd "$G" || die "can't enter $G"
"$PROTON_BIN" run "$G/TF2VR/tools/crash_monitor.exe" "$(win "$G/TF2VR")" "$(win "$G/Titanfall2VRLauncher.exe")" "${ARGS[@]}" "$@" &
proton_pid=$!

# Wait for the game itself. Do NOT wait for crash_monitor.exe by name.
#
# The old check was `pgrep -f '^Z:.*crash_monitor\.exe'`, which can never match: Wine
# processes are exec'd as `wine64-preloader`, so no /proc/*/cmdline ever begins with `Z:`.
# `monitor_running` therefore returned false on every call, the 60-iteration loop below
# spun out its full count (~71 s of wall clock), and the script then fell straight through
# to `wineserver -k` and tore down the prefix *while the game was still running*. That
# teardown - not a crash - is what ended Titanfall2.exe, 57-61 s in, every run. The run5
# sigtrace log shows exactly 60 `kill -0 $proton_pid` probes followed by teardown 1.03 s
# after the 60th, then every wine64 client dying inside a 24 ms SIGQUIT cascade.
#
# Titanfall2VRLauncher.exe *is* the game process: it maps client.dll, engine.dll,
# mileswin64.dll, bink2w64.dll and Northstar.dll itself, and there is no separate
# Titanfall2.exe anywhere. Wine sets a PE's /proc/<pid>/comm to the exe's basename and the
# kernel caps comm at 15 characters, so the game's comm is the truncated "Titanfall2VRLau".
# Matching that prefix costs one pgrep - a single process that scans /proc itself in ~26 ms -
# instead of thousands of per-pid greps.
#
# Do NOT match on the command line instead: `pgrep -f Titanfall2` also matches this prefix's
# Proton wrapper, its crash_monitor.exe, and an unrelated steam.exe whose arguments contain
# the game's install path.
game_pid=""
game_start=""
proc_id() {
  local rest
  read -r rest 2>/dev/null < "/proc/$1/stat" || return 1
  rest=${rest##*) }          # strip "pid (comm) "; comm may contain spaces or parens
  set -- $rest
  [ "$#" -ge 20 ] || return 1
  echo "${1} ${20}"          # state, then starttime (field 22 overall)
}
find_game_pid() {
  local p c
  p=$(pgrep '^Titanfall2VR' 2>/dev/null | head -1)
  [ -n "$p" ] && { echo "$p"; return 0; }
  # Belt and braces: if a Wine build leaves comm as wine64-preloader, fall back to searching
  # maps - but only among processes that can have a PE mapped at all.
  for p in /proc/[0-9]*; do
    # stderr is redirected *before* the input redirect on purpose: a pid can vanish between
    # the glob and the read, and bash reports that on the input redirect, which a 2>/dev/null
    # placed after it would not suppress.
    read -r c 2>/dev/null < "$p/comm" || continue
    case "$c" in wine*) ;; *) continue ;; esac
    grep -qF Titanfall2VRLauncher.exe "$p/maps" 2>/dev/null || continue
    echo "${p#/proc/}"
    return 0
  done
  return 1
}
game_running() {
  local id st
  if [ -n "$game_pid" ]; then
    # Check the start time as well as liveness, so a recycled pid cannot keep this loop alive
    # forever, and reject zombies - they still answer kill -0 and keep their start time, so
    # a corpse would otherwise hold the launcher open indefinitely.
    if id=$(proc_id "$game_pid"); then
      st=${id%% *}
      if [ "$st" != Z ] && [ "${id##* }" = "$game_start" ]; then
        return 0
      fi
    fi
    game_pid=""
  fi
  game_pid=$(find_game_pid) || return 1
  id=$(proc_id "$game_pid") || return 1
  game_start=${id##* }
  return 0
}
# Startup wait: the game appears ~12 s in. If it never turns up, do not tear the prefix down
# on a guess - fall back to waiting for Proton, which cannot kill a live game.
for _ in $(seq 1 120); do game_running && break; kill -0 "$proton_pid" 2>/dev/null || break; sleep 1; done
if [ -z "$game_pid" ]; then
  echo "Game process not found; waiting for the Proton run to end rather than tearing down."
  game_running() { kill -0 "$proton_pid" 2>/dev/null; }
fi
while game_running; do sleep 2; done
[ -n "$presence_pid" ] && kill "$presence_pid" 2>/dev/null

# crash_monitor.exe records how the game ended in its newest session folder
session=$(ls -1d "$G"/TF2VR/crashes/*/ 2>/dev/null | tail -n 1)
# The loop above ends when the *game* dies, but crash_monitor.exe is still alive at that
# moment and writes process_exit a moment later. Give it a bounded moment to do so, or the
# exit code below is a race and reads "unknown" for a clean exit. Bounded, because a
# teardown hard enough to kill the monitor as well would never write it, and we must not
# hang here.
for _ in $(seq 1 25); do
  grep -q 'process_exit' "$session/monitor.txt" 2>/dev/null && break
  sleep 0.2
done
rc=$(sed -n 's/.*process_exit pid=[0-9]* code=\([0-9-]*\).*/\1/p' "$session/monitor.txt" 2>/dev/null | tail -n 1)
echo "Game exited with code ${rc:-unknown}"

# Close the EA app and the rest of the Wine session too; while it runs, Steam still
# shows Titanfall 2 as running and won't start it normally. Then end what outlived the wineserver.
WINEPREFIX="$PREFIX_DIR/pfx" "$(dirname "$PROTON_BIN")/files/bin/wineserver" -k 2>/dev/null
for _ in $(seq 1 10); do
  [ -z "$(prefix_pids)" ] && break
  kill_orphans && break
  sleep 0.5
done
wait "$proton_pid" 2>/dev/null

[ -n "$PROTON_LOG_FILE" ] && echo "Proton log saved to $PROTON_LOG_FILE"
[ "${rc:-1}" = 0 ] || die "Titanfall 2 VR exited with code ${rc:-unknown} - see $LOG, ${session:-$G/TF2VR/crashes} and $G/TF2VR/logs"
